DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NEXTAUTH_SECRET="ganti-dengan-string-random-min-32-char"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — pakai salah satu prefix, keduanya didukung (GOOGLE_* prioritas)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Alternatif alias (legacy, tetap didukung):
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# AI
GEMINI_API_KEY=""

# Optional — set 1 untuk skip validasi env saat `next build` di CI tanpa DB
# SKIP_ENV_VALIDATION=1
